# ── STT ─────────────────────────────────────
# "http" (遠端，不需 GPU) | "local" (需 GPU)
STT_MODE=http
STT_BASE_URL=http://host.docker.internal:8100/v1
STT_API_KEY=
STT_SAMPLE_RATE=16000
# 提示詞只建議放專有名詞/熱詞，避免放「請用繁中...」這類指令句。
STT_PROMPT=
STT_MIN_AUDIO_SECS=0.40
STT_MIN_AUDIO_RMS=180

# local 模式設定（STT_MODE=local 時使用）
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=zh

# ── TTS ─────────────────────────────────────
TTS_BASE_URL=http://host.docker.internal:8200/v1
# Realtime WebSocket endpoint base (optional). ex: http://host.docker.internal:8201/v1
# 留空會自動由 TTS_BASE_URL 推導（8200/8202 -> 8201）
TTS_STREAM_BASE_URL=http://host.docker.internal:8201/v1
TTS_API_KEY=
TTS_MODEL=kokoro
TTS_VOICE=zf_001
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT_SECS=45

# ── LLM (openai_agent) ─────────────────────
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5:7b

# ── Voice Service ───────────────────────────
PIPECAT_HOST=0.0.0.0
PIPECAT_PORT=8300
# Comma/space/newline separated ICE servers.
# 可用 JSON list（字串或物件）：
# PIPECAT_ICE_SERVERS=["stun:stun.l.google.com:19302",{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ── VAD ─────────────────────────────────────
VAD_STOP_SECS=0.5
ALLOW_INTERRUPTIONS=false

# ── System Prompt ───────────────────────────
# SYSTEM_PROMPT=你是一個友善的 AI 語音助手。
